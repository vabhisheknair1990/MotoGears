# Copy this file to ".env" (same folder as docker-compose.yml) and fill in your keys,
# then run:  docker compose up -d --build
# Docker Compose reads it automatically. Never commit the real .env.

# Razorpay test keys: https://dashboard.razorpay.com → Account & Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Only needed if you register a webhook (requires a public URL, e.g. via ngrok)
RAZORPAY_WEBHOOK_SECRET=

# Keep the simulated demo card/UPI methods alongside Razorpay (set false in production)
PAYMENT_DEMO_METHODS=true
