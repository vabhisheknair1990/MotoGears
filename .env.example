# Local development settings for docker compose.
#   cp .env.example .env   then   docker compose up -d --build
# For the live server use .env.production.example instead. Never commit the real .env.

# Also start phpMyAdmin (http://localhost:8090). Remove for a server.
COMPOSE_PROFILES=tools

# Address the browser uses for the API (baked into the frontend build).
API_URL=http://localhost:8000/v1

# Razorpay test keys: https://dashboard.razorpay.com → Account & Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you register a webhook (requires a public URL, e.g. via ngrok)
RAZORPAY_WEBHOOK_SECRET=

# Keep the simulated demo card method alongside Razorpay
PAYMENT_DEMO_METHODS=true

# UPI on our own page (QR code + UPI ID). auto = Razorpay when keys are set, otherwise a
# simulator (with "Simulate payment" buttons) while PAYMENT_DEMO_METHODS=true.
UPI_ENABLED=true
UPI_PROVIDER=auto
UPI_QR_TTL_MINUTES=10
UPI_COLLECT_TTL_MINUTES=5
