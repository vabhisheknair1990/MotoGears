# Production settings for themotogears.in — copy to .env on the server and fill in the blanks:
#   cp .env.production.example .env
#   docker compose up -d --build
# Then point an HTTPS reverse proxy at the two ports (see README → "Production").
# Never commit the real .env.

# ── Addresses ──────────────────────────────────────────────────
# Browser → API. Baked into the frontend: rebuild the frontend after changing it.
API_URL=https://api.themotogears.in/v1
APP_URL=https://api.themotogears.in
FRONTEND_URL=https://themotogears.in
CORS_ALLOWED_ORIGINS=https://themotogears.in,https://www.themotogears.in
SANCTUM_STATEFUL_DOMAINS=themotogears.in,www.themotogears.in

# ── App ────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning

# ── First start ────────────────────────────────────────────────
# No demo products/orders/customers/logins on the live store. The first admin is created
# from these values when the database is empty (then you can delete ADMIN_PASSWORD from .env).
SEED_DEMO_DATA=false
ADMIN_NAME=Store Owner
ADMIN_EMAIL=admin@themotogears.in
ADMIN_PASSWORD=

# ── Ports (listen on localhost only; nginx/Caddy on this server proxies to them) ──
BIND_ADDRESS=127.0.0.1
WEB_PORT=4200
API_PORT=8000
# phpMyAdmin stays off in production (no "tools" profile).
COMPOSE_PROFILES=

# ── Database — CHANGE THESE before the first start (they are set when the volume is created) ──
DB_DATABASE=automotive_shop
DB_USERNAME=motogears
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

# ── Mail (order emails, password reset) ────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@themotogears.in

# ── Payments ───────────────────────────────────────────────────
PAYMENT_DEMO_METHODS=false
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → https://api.themotogears.in/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
