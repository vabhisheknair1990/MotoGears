APP_NAME=MotoGears
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://api.themotogears.in

# Public URL of the Angular storefront (used in emails and as the default CORS origin)
FRONTEND_URL=https://themotogears.in
# Comma-separated list of browser origins allowed to call the API. Never "*" in production.
CORS_ALLOWED_ORIGINS=https://themotogears.in,https://www.themotogears.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automotive_shop
DB_USERNAME=root
DB_PASSWORD=

# Token-based SPA auth. Tokens expire after this many minutes (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=themotogears.in,www.themotogears.in

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Background jobs (product imports). "database" needs a worker: php artisan queue:work
# (Docker starts one automatically). Use "sync" to run jobs inside the web request instead.
QUEUE_CONNECTION=database
# Must be longer than the longest job (imports allow up to 1 hour).
DB_QUEUE_RETRY_AFTER=3700
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@motogears.example"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (Docker nginx network).
TRUSTED_PROXIES=

# ---- Payments ----
# Show the simulated "Demo card" / "Demo UPI" methods (set false in production).
PAYMENT_DEMO_METHODS=false
# Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys). Leave blank to hide Razorpay.
# Use rzp_test_… keys for testing. The secret stays on the server — never put it in Angular.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you chose for https://<your-domain>/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- Production (themotogears.in) ----
# The API is served from its own host at the root: https://api.themotogears.in/v1/...
# APP_URL=https://api.themotogears.in
# FRONTEND_URL=https://themotogears.in
# CORS_ALLOWED_ORIGINS=https://themotogears.in,https://www.themotogears.in
# APP_ENV=production
# APP_DEBUG=false

# First start on an empty database: clean live store + this admin (no demo data).
SEED_DEMO_DATA=false
ADMIN_NAME="Store Owner"
ADMIN_EMAIL=admin@themotogears.in
ADMIN_PASSWORD=
